# Configuración de Firebase para San Ambrosio de Milán
# Copia este archivo a .env y completa con las credenciales de tu proyecto

VITE_FIREBASE_API_KEY=tu_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=sanambrosiodb.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sanambrosiodb
VITE_FIREBASE_STORAGE_BUCKET=sanambrosiodb.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=tu_messaging_sender_id
VITE_FIREBASE_APP_ID=tu_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_FIREBASE_VAPID_KEY=

# Configuración de Resend (Envío de correos de inasistencia)
VITE_RESEND_API_KEY=re_tu_api_key_aqui
VITE_RESEND_FROM_EMAIL=Colegio San Ambrosio <onboarding@resend.dev>
VITE_TEST_EMAIL_RECIPIENT=andresmholguin@gmail.com
