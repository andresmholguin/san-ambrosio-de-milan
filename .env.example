# Configuración del Colegio San Ambrosio de Milán
# Copia este archivo como ".env" o ".env.local" y rellena con tus credenciales.

# Google Sheets (Base de datos principal)
# URL de la aplicación web de Google Apps Script (obtenida al desplegar el script)
VITE_GOOGLE_SHEETS_URL=https://script.google.com/macros/s/xxxx/exec

# Supabase (Base de datos secundaria - Opcional)
VITE_URL=https://tu-proyecto.supabase.co
VITE_API_KEY=tu-anon-key-de-supabase
